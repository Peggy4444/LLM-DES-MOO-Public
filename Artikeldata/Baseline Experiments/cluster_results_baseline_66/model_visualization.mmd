splitter1 -->|toggle| pre_press1_buffer
splitter1 -->|toggle| pre_press2_buffer
pre_press1_buffer --> presses_cell1
pre_press2_buffer --> presses_cell2
presses_cell1 --> press1_out
presses_cell2 --> press2_out
press1_out --> merger1
press2_out --> merger1
merger1 --> post_press12_buffer
post_press12_buffer --> quality_station
quality_station --> finished_sink
quality_station --> defects_sink