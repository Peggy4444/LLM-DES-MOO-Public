classDef store fill:#ffe08a,stroke:#b87a00,stroke-width:1px,color:#000;
classDef sink fill:#ffb3b3,stroke:#990000,stroke-width:1px,color:#000;
classDef defect fill:#ff9999,stroke:#660000,stroke-width:1px,color:#000;
classDef helper fill:#e0e0e0,stroke:#666666,stroke-width:1px,color:#000;

raw_input["**Raw input**\ncapacity=1000"]:::store
loading_robot["**Loading robot**\nPT=12s\nAV=90.49%"]:::machine
post_loading_buffer["**Post loading\nbuffer**\ncap=2 delay=10s"]:::buffer
conveyor_belt["**Conveyor belt**\nPT=6s\nAV=100%"]:::machine
post_conveyor_buffer["**Post conveyor\nbuffer**\ncap=2 delay=10s"]:::buffer
washing_machine["**Washing machine**\nPT=14s\nAV=80.89%"]:::machine
post_washing_buffer["**Post washing\nbuffer**\ncap=2 delay=10s"]:::buffer
hantering_cell["**Hantering cell**\nPT=25s\nAV=97.79%"]:::machine

pre_press1_store["**Pre-press\nstore (out)**\ncap=3"]:::store
splitter1["**Splitter\nhantering->presses**\nround-robin"]:::helper

pre_press1_buffer["**Pre-press1\nbuffer**\ncap=3 delay=32s"]:::buffer
pre_press2_buffer["**Pre-press2\nbuffer**\ncap=3 delay=32s"]:::buffer

presses_cell1["**Presses cell 1**\nPT=175s\nAV=87.79%"]:::machine
presses_cell2["**Presses cell 2**\nPT=176s\nAV=87.69%"]:::machine

